{
  "name": "loamkeep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "description": "A 16-bit-style exploration platformer in TypeScript + PixiJS",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint",
    "video:generate": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
